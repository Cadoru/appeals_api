APP_NAME=Feedback Platform
DEBUG=false
SECRET_KEY=replace-with-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

DATABASE_URL=sqlite+aiosqlite:///./feedback.db
# PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/feedback

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=.pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg,.gif,.webp,.txt,.zip

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD="your-app-password"
SMTP_FROM=your-email@gmail.com
SMTP_USE_TLS=true

TELEGRAM_BOT_TOKEN=
PUBLIC_BASE_URL=http://localhost:8000
